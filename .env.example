# EstateEase Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Application Branding
VITE_APP_NAME="EstateEase"
VITE_APP_TAGLINE="Find Your Place. Feel at Home."

# Regional & Currency Settings
VITE_CURRENCY_SYMBOL="₹"
VITE_CURRENCY_CODE="INR"

# Contact Information
VITE_CONTACT_EMAIL="concierge@estateease.com"
VITE_CONTACT_PHONE="+1 (800) 555-EASE"
VITE_OFFICE_ADDRESS="740 Madison Avenue, New York, NY 10065"

# Map Defaults (OpenStreetMap / Leaflet)
VITE_MAP_DEFAULT_LAT=40.7128
VITE_MAP_DEFAULT_LNG=-74.0060
VITE_MAP_DEFAULT_ZOOM=13

# Feature Flags & API Simulation
VITE_ENABLE_MOCK_AUTH="true"
VITE_API_BASE_URL=""

